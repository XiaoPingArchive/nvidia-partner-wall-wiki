<style>
     .hero-banner {
        position: relative;
        background-repeat: no-repeat;
        background-position: center top;
        background-size: cover;
        padding: 70% 0 0;
        background-position-y: center;
    }

    .slick-next:before
    {
        /*content: ">"!important;*/
        padding-left: 5px!important;
    }

    .slick-prev:before
    {
        /*content: "<"!important;*/
        padding-right: 5px!important;
    }

    [class*="hero_ctn_btn"], [class*="hero_ctn_btn"]:link 
    {
        position: relative;
        text-align: center;
        display: inline-block;
        font-size: 18px;
        font-weight: 500;
        padding: 8px 25px;
        border: 1px solid transparent;
        -webkit-transition: .2s ease-in-out;
        transition: .2s ease-in-out;
    }

    [class*="hero_ctn_btn"]:after, [class*="hero_ctn_btn"]:link:after 
    {
        content: "\f105";
        font-family: 'FontAwesome';
        visibility: visible;
        margin-left: 15px;
    }

    .hero-banner-copy h1, .hero-banner-copy p {
        color: #fff;
        padding: 5% 5% 5% 6.5%!important;
    }

    .hero-banner-copy h1 {
        font-size: 12vw;
        font-weight: 400;
        margin: 0;
    }

    .hero-banner-copy p {
        font-size: 6vw;
        line-height: 1.4;
        position: relative;
        background-color: #cf3339;
        padding: 5% 5% 5% 6.5%!important;
    }

       /* change form transparent box CTA */
    .slider-content-white{
	    background-color: rgba(255,255,255,0.5);
	    color: #293133!important;
    }
    .slider-content-white h1, .slider-content-white p{
	    color: #293133!important;
    }
    .slider-content-black{
	    background-color: rgba(000,000,000,0.5);
	    color: #FFF!important;
    }
    .slider-content-black h1, .slider-content-black p{
	    color: #FFF!important;
    }
    /* end change */ 

    .hero-banner-copy p:before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 6vw;
        bottom: 0;
        background: #dd7074;
        background: -moz-linear-gradient(left, #dd7074 0%, #dd7074 50%, #d4474c 50%, #d4474c 100%);
        background: -webkit-linear-gradient(left, #dd7074 0%, #dd7074 50%, #d4474c 50%, #d4474c 100%);
        background: linear-gradient(to right, #dd7074 0%, #dd7074 50%, #d4474c 50%, #d4474c 100%);
        filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#dd7074', endColorstr='#e0eff9', GradientType=1);
    }
    .hero-banner img {
        width: 100%;
    }
    .hero-banner-black .hero-banner-copy p {
        background-color: #293133;
    }
    .hero-banner-black .hero-banner-copy p:before {
        background: #696e70;
        background: -moz-linear-gradient(left, #696e70 0%, #696e70 50%, #3e4547 50%, #3e4547 100%);
        background: -webkit-linear-gradient(left, #696e70 0%, #696e70 50%, #3e4547 50%, #3e4547 100%);
        background: linear-gradient(to right, #696e70 0%, #696e70 50%, #3e4547 50%, #3e4547 100%);
        filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#696e70', endColorstr='#e0eff9', GradientType=1);
    }
