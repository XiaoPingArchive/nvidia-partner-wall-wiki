<script>
document.addEventListener("DOMContentLoaded", () => {
  gsap.registerPlugin(TextPlugin);

  const el = document.querySelector(".ts-h1.is-home.is-type");
  if (!el) return;

  const words = ["your model", "Nemotron 3", "Llama", "Gemma 4", "gpt-oss", "Qwen", "DeepSeek"];
  const tl = gsap.timeline({ repeat: -1 });

  words.forEach((word) => {
    tl.to(el, {
      duration: 1, 
      text: word,
      ease: "none",
    })
    .to({}, { duration: 0.6 })
    .to(el, {
      duration: 0.4, 
      text: "",
      ease: "none",
    });
  });

  gsap.to(el, {
    borderRightColor: "transparent",
    duration: 0.6,
    repeat: -1,
    yoyo: true,
    ease: "none",
  });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const services = document.querySelectorAll(".services-dd");
  const MOBILE_BREAKPOINT = 992;

  if (!services.length) return;

  services.forEach((item) => {
    item.addEventListener("mouseenter", () => {
      if (window.innerWidth < MOBILE_BREAKPOINT) return; 

      services.forEach((el) => el.classList.remove("is-active"));
      item.classList.add("is-active");
    });

    item.addEventListener("click", (event) => {
      if (window.innerWidth >= MOBILE_BREAKPOINT) return;

      const isActive = item.classList.contains("is-active");

      services.forEach((el) => el.classList.remove("is-active"));

      if (!isActive) {
        item.classList.add("is-active");
      }
    });
  });
});


</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  const servicesSlider = document.querySelector(".swiper.is-services");
  const controlsDesktop = document.querySelector(".services-slider-pg");
  const controlsMobile = document.querySelector(".services-slider-pg.is-mobile");
  if (!servicesSlider) return;
  const wrapper = servicesSlider.querySelector(".swiper-wrapper");
  if (wrapper) {
    const ordered = [...wrapper.querySelectorAll("[data-order]")]
  .filter(slide => !isNaN(Number(slide.dataset.order)) && slide.dataset.order.trim() !== "")
  .sort((a, b) => Number(a.dataset.order) - Number(b.dataset.order));
    ordered.forEach(slide => wrapper.prepend(slide));
  }
  const prevButtons = [];
  const nextButtons = [];
  if (controlsDesktop) {
    prevButtons.push(controlsDesktop.querySelector(".slider-arrow:first-child"));
    nextButtons.push(controlsDesktop.querySelector(".slider-arrow:last-child"));
  }
  if (controlsMobile) {
    prevButtons.push(controlsMobile.querySelector(".slider-arrow:first-child"));
    nextButtons.push(controlsMobile.querySelector(".slider-arrow:last-child"));
  }
  const swiper = new Swiper(servicesSlider, {
    slidesPerView: "auto",
    spaceBetween: 0,
    navigation: {
      prevEl: prevButtons.filter(Boolean),
      nextEl: nextButtons.filter(Boolean),
    },
  });
});
</script>


<script>
document.addEventListener("DOMContentLoaded", () => {
  if (!window.gsap) return;
  gsap.registerPlugin(ScrollTrigger);

  const wrap = document.querySelector(".cards-scroll-wr");
  if (!wrap) return;

  const tabs = Array.from(document.querySelectorAll(".hm-levels-tab"));
  if (!tabs.length) return;

  // --- helpers ---
  function calcTargetWidth(tab) {
    const container = tab.closest(".container-huge");
    const tabInfo = tab.querySelector(".hm-level-tab_info");
    if (!container || !tabInfo) return null;

    const containerRect = container.getBoundingClientRect();
    const tabRect = tab.getBoundingClientRect();
    const direction = tab.getAttribute("data-line");

    if (direction === "left") {
      const distanceToLeft = tabRect.right - containerRect.left - 32;
      tabInfo.style.left = "auto";
      tabInfo.style.right = ""; 
      return Math.max(0, distanceToLeft);
    } else {
      const distanceToRight = containerRect.right - tabRect.left - 32;
      tabInfo.style.right = "auto";
      tabInfo.style.left = "";
      return Math.max(0, distanceToRight);
    }
  }

  function openTab(tab, immediate = false) {
    const tabInfo = tab.querySelector(".hm-level-tab_info");
    if (!tabInfo) return;

    const w = calcTargetWidth(tab);
    if (w === null) return;

    tab.classList.add("is-open");
    gsap.to(tabInfo, {
      width: w,
      duration: immediate ? 0 : 0.35,
      ease: "power2.out",
      overwrite: "auto"
    });
  }

  function closeTab(tab, immediate = false) {
    const tabInfo = tab.querySelector(".hm-level-tab_info");
    if (!tabInfo) return;

    tab.classList.remove("is-open");
    gsap.to(tabInfo, {
      width: 0,
      duration: immediate ? 0 : 0.25,
      ease: "power2.inOut",
      overwrite: "auto"
    });
  }

  function openOnly(index, immediate = false) {
    tabs.forEach((t, i) => (i === index ? openTab(t, immediate) : closeTab(t, immediate)));
  }

  // --- scroll steps (vh) ---
  const stepsVh = [0, 50, 100, 150];
  let activeIndex = -1;

  function getIndexByScroll(offsetPx) {
    const pxPerVh = window.innerHeight / 100;
    const stepsPx = stepsVh.map(vh => vh * pxPerVh);

    let idx = 0;
    for (let i = 0; i < stepsPx.length; i++) {
      if (offsetPx >= stepsPx[i]) idx = i;
    }
    return Math.min(idx, tabs.length - 1);
  }

  // --- ScrollTrigger ---
  ScrollTrigger.create({
    trigger: wrap,
    start: "top top",
    end: "bottom top",
    onEnter(self) {
      activeIndex = 0;
      openOnly(0, true);
    },
    onEnterBack(self) {
      const offset = self.scroll() - self.start;
      const idx = getIndexByScroll(offset);
      activeIndex = idx;
      openOnly(idx, true);
    },
    onUpdate(self) {
      const offset = self.scroll() - self.start;
      const idx = getIndexByScroll(offset);
      if (idx !== activeIndex) {
        activeIndex = idx;
        openOnly(idx);
      }
    }
  });

  document.querySelectorAll(".hm-tab-close").forEach(btn => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      tabs.forEach(t => closeTab(t));
      activeIndex = -1;
    });
  });

  // resize recalculation
  window.addEventListener("resize", () => {
    const open = document.querySelector(".hm-levels-tab.is-open");
    if (open) openTab(open, true);
    ScrollTrigger.refresh();
  });
});
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const cards = document.querySelectorAll('.card-hover-trigger');

    cards.forEach(card => {
      card.addEventListener('click', () => {
        cards.forEach(c => c.classList.remove('is-active'));
        card.classList.add('is-active');
      });
    });
  });
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    let swiperBlog;
    window.fsAttributes = window.fsAttributes || [];
    window.fsAttributes.push([
      "cmsfilter",
      (filtersInstances) => {
        const filters = filtersInstances[0];

        filters.listInstance.on("renderitems", () => {
          initSwiperBlog();
        });
      }
    ]);

    function initSwiperBlog() {
      if (swiperBlog) swiperBlog.destroy(true, true);
      swiperBlog = new Swiper('.swiper.blog-slider', {
        slidesPerView: 'auto',
        spaceBetween: 4,
        navigation: {
          nextEl: '[data-slider-arrow="blog"] [data-slider-arrow="next"]',
          prevEl: '[data-slider-arrow="blog"] [data-slider-arrow="back"]',
        },
      });
    }
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const covers = document.querySelectorAll('.video-cover-wr');

    covers.forEach(cover => {
      cover.addEventListener('click', () => {
        const wrapper = cover.closest('.video-wr-full');
        const iframe = wrapper.querySelector('iframe');
        const src = iframe.dataset.src;

        iframe.setAttribute('src', src);

        cover.style.display = 'none';
      });
    });
  });
</script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const quotesSlider = new Swiper('.swiper.is-quotes', {
      slidesPerView: 1,
      spaceBetween: 4,
      initialSlide: 1,
      loop: true,
      loopAdditionalSlides: 4,
      navigation: {
        nextEl: '[data-slider-arrow="quotes"] [data-slider-arrow="next"]',
        prevEl: '[data-slider-arrow="quotes"] [data-slider-arrow="back"]',
      },
    });
  });
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const coversQuotes = document.querySelectorAll('.quote-video-cover-wr');

  coversQuotes.forEach(cover => {
    cover.addEventListener('click', () => {
      const parent = cover.parentElement;
      const embedWrapper = parent.querySelector('.quote-video-embed');
      const iframe = embedWrapper?.querySelector('iframe');

      if (!iframe) return;

      const src = iframe.dataset.src;
      iframe.setAttribute('src', src);

      cover.style.display = 'none';
    });
  });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", () => {
  gsap.registerPlugin(ScrollTrigger);

  const scrollText = document.querySelector(".ts-h3-scroll");
  if (!scrollText) return;

  const originalText = scrollText.textContent.trim();

  const wrappedText = originalText
    .split(" ")
    .map(word => {
      const wrappedChars = word
        .split("")
        .map(char => `<span class="char">${char}</span>`)
        .join("");
      return `<span class="word">${wrappedChars}</span> `;
    })
    .join("");

  scrollText.innerHTML = wrappedText;

  const letters = scrollText.querySelectorAll(".char");

  gsap.set(letters, {
    color: "#3C4C2E80",
  });

  const endValue = window.innerWidth < 992 ? "bottom 50%" : "bottom 50%";

  gsap.to(letters, {
    color: "#181717",
    stagger: {
      each: 0.03,
      ease: "power2.out",
    },
    scrollTrigger: {
      trigger: ".is-scroll-text",
      start: "top 100%",
      end: endValue,
      scrub: true,
    },
  });
});
</script>
</body></html>