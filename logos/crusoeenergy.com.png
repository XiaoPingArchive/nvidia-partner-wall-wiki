</style></div><div class="cc-video w-embed"><style>
  .video-cover{
    transition: 500ms ease transform;
  }
  .video-cover-wr:hover .video-cover{
    transform: scale(1.02);
  }
  [data-player-root] {
    width: 100%;
    max-width: 100%;
    position: relative;
    background: #000;
    overflow: hidden;
  }

  [data-player-video] {
    width: 100%;
    display: block;
    aspect-ratio: 16/9;
    background: #000;
    cursor: pointer;
  }
  [data-player-video][data-player-1-1] {
    width: 100%;
    display: block;
    aspect-ratio: 1/1;
    background: #000;
    cursor: pointer;
  }
  [data-player-video][data-player-9-16]{
    width: 100%;
    display: block;
    aspect-ratio: 9/16;
    background: #000;
    cursor: pointer;
  }

  [data-player-controls] {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    opacity: 1;
    transition: opacity 0.3s;
    z-index: 1;
  }
  [data-player-controls-top]{
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    opacity: 1;
    transition: opacity 0.3s;
    z-index: 1;
    padding: 1rem .75rem;
  }
  [data-player-root]:has([data-player-1-1]) .controls-row{
    padding: .75rem;
  }
  .controls-bg-overlay{
    background: #FFFFFF1A;
    backdrop-filter: blur(30px);
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    top: 0;
    z-index: -1;
  }

  [data-player-root].hide-controls [data-player-controls] {
    opacity: 0;
  }

  [data-player-timeline] {
    position: relative;
    height: 3px;
    cursor: pointer;
  }

  [data-player-timeline-track] {
    width: 100%;
    height: 4px;
    background: #FFFFFF80;
    border-radius: 2px;
    position: relative;
    overflow: visible;
    transition: height 0.15s;
  }

  [data-player-timeline]:hover [data-player-timeline-track] {
  }

  [data-player-timeline-buffered] {
    position: absolute;
    left: 0; top: 0;
    height: 100%;
    background: rgba(255,255,255,0.35);
    border-radius: 2px;
    pointer-events: none;
  }

  [data-player-timeline-progress] {
    position: absolute;
    left: 0; top: 0;
    height: 100%;
    background: #CEEB13;
    border-radius: 2px;
    pointer-events: none;
  }

  [data-player-timeline-thumb] {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #f0c040;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
    display: none;
  }

  [data-player-timeline]:hover [data-player-timeline-thumb] {
    opacity: 1;
  }

  [data-player-timeline-preview] {
    position: absolute;
    bottom: calc(100%);
    transform: translateX(-50%);
    pointer-events: none;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    z-index: 100;
    padding-bottom: 24px;
  }

  [data-player-timeline-preview].visible {
    display: flex;
  }

  [data-player-preview-canvas] {
    width: 160px;
    height: 90px;
    border-radius: 4px;
    display: block;
    border: 1px solid #FFFFFF66;
  }

  [data-player-preview-time] {
    font-size: 12px;
    color: #fff;
    font-weight: 500;
    letter-spacing: 0.3px;
  }

  .preview-arrow {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 28px;
    overflow: hidden;
  }

  .preview-arrow::after {
    content: '';
    position: absolute;
    top: -4px;
    left: 50%;
    width: 2px;
    height: 28px;
    background: #fff;
  }

  .controls-row {
    display: flex;
    align-items: center;
  }

  .controls-left, .neaxt-back-wr {
    display: flex;
    align-items: center;
    flex: 1;
  }

  .controls-right {
    display: flex;
    align-items: center;
  }

  .btn {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.9);
    transition: background 0.15s, color 0.15s;
    position: relative;
    flex-shrink: 0;
    width: 5.25rem;
    height: 5.25rem;
    border-right: 1px solid #FFFFFF29;
  }

  .btn:hover {
    background: #0000001F;
    color: #fff;
  }
  [data-player-root]:has([data-player-1-1]) .btn,
  [data-player-controls-top] .btn,
  [data-player-controls-top] [data-player-speed-toggle]{
    background-color: #FFFFFF1A;
    backdrop-filter: blur(30px);
    border: 1px solid #FFFFFF29;
  }
  [data-player-root]:has([data-player-1-1]) .btn:hover,
  [data-player-controls-top] .btn:hover 
  [data-player-controls-top] [data-player-speed-toggle]:hover{
    background: #0000001F;
    color: #fff;
  }
  [data-player-root]:has([data-player-1-1]) .controls-left > *:first-child {
    border-right: none;
  }

  [data-player-root]:has([data-player-9-16]) [data-player-speed-menu]{
    top: 83px;
    left: auto;
    right: 0;
    bottom: auto;
  }

  .controls-right > *:first-child {
    border-left: 1px solid #FFFFFF29;
  }

  .controls-right > *:last-child {
    border-right: unset;
  }

  .btn svg {
    display: block;
  }

  .time-display {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    cursor: pointer;
  }

  [data-player-time-current] { color: #fff; }
  .time-sep                  { 
    color: #fff;
    margin-right: 4px;
    margin-left: 4px;
  }
  [data-player-time-duration]{ 
    color: #fff; 
  }

  .volume-wrap { position: relative; }

  [data-player-volume-dropdown] {
    position: absolute;
    bottom: 83px;
    background: #0000001A;
    border: 1px solid #FFFFFF29;
    display: none;
    flex-direction: column;
    align-items: center;
    z-index: 200;
    width: 84px;
    backdrop-filter: blur(30px);
    padding: 1.5rem 0px;
  }

  [data-player-volume-dropdown].open { display: flex; }

  .volume-slider-wrap {
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  [data-player-volume-track] {
    position: relative;
    width: 2px;
    height: 100%;
    background: #FFFFFF4D;
    cursor: pointer;
    user-select: none;
    transition: width 0.12s;
  }

  [data-player-volume-fill] {
    position: absolute;
    bottom: 0; left: 0;
    width: 100%;
    height: 100%;
    background: #fff;
    pointer-events: none;
  }

  [data-player-volume-thumb] {
    position: absolute;
    left: 50%;
    bottom: 100%;
    transform: translate(-50%, 50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #fff;
    cursor: grab;
  }

  [data-player-volume-range] {
    -webkit-appearance: none;
    appearance: none;
    writing-mode: vertical-lr;
    direction: rtl;
    width: 4px;
    height: 80px;
    background: transparent;
    cursor: pointer;
    outline: none;
  }

  [data-player-volume-range]::-webkit-slider-runnable-track {
    width: 4px;
    border-radius: 2px;
    background: rgba(255,255,255,0.25);
  }

  [data-player-volume-range]::-moz-range-track {
    width: 4px;
    border-radius: 2px;
    background: rgba(255,255,255,0.25);
  }

  [data-player-volume-range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #f0c040;
    margin-left: -5px;
    cursor: pointer;
  }

  [data-player-volume-range]::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #f0c040;
    border: none;
    cursor: pointer;
  }

  [data-player-volume-label] {
    font-size: 11px;
    color: rgba(255,255,255,0.5);
    text-align: center;
  }

  .dropdown-wrap { 
    position: relative; 
    width: 5.25rem;
    height: 5.25rem;
  }

  [data-player-speed-toggle] {
    font-size: 14px;
    color: #fff;
    font-weight: 400;
    text-align: center;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    user-select: none;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid #FFFFFF29;
  }

  [data-player-speed-toggle]:hover {
    background: #0000001F;
    color: #fff;
  }

  .video-overlay{
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.5) 100%);
    height: 250px;
    pointer-events: none;
  }
  .video-overlay-top{
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.5) 100%);
    height: 250px;
    pointer-events: none;
  }

  [data-player-speed-menu] {
    position: absolute;
    bottom: 83px;
    left: 0%;
    background: #0000001A;
    border: 1px solid #FFFFFF29;
    overflow: hidden;
    min-width: 100px;
    display: none;
    flex-direction: column;
    z-index: 200;
    backdrop-filter: blur(40px)
  }

  [data-player-speed-menu].open { display: flex; }

  [data-player-speed] {
    padding: 10px 20px;
    font-size: 13px;
    color: #fff;
    cursor: pointer;
    text-align: left;
    transition: background 0.1s, color 0.1s;
    white-space: nowrap;
    border-top: 1px solid transparent;
    border-bottom: 1px solid transparent;
  }

  [data-player-speed]:hover { 
    background-color: #0000004D;
    border-top: 1px solid #FFFFFF29;
    border-bottom: 1px solid #FFFFFF29;
  }
  [data-player-speed].active { 
  }

  video::-webkit-media-controls-picture-in-picture-button {
    display: none;
  }

  [data-player-captions].active svg { color: #f0c040; }

  [data-player-root]:fullscreen [data-player-video]          { aspect-ratio: auto; height: 100vh; }
  [data-player-root]:-webkit-full-screen [data-player-video] { aspect-ratio: auto; height: 100vh; }

  .time-display{
    position: absolute;
    top: -46px;
    left: 10px;
    padding: 8px 12px 8px 12px;
    border-radius: 5px;
    background-color: #0000004D;
    color: #fff;
    backdrop-filter: blur(30px);
    font-size: 14px;
  }

  [data-player-play] .embed-icon:nth-child(1),
  [data-player-volume-toggle] .embed-icon:nth-child(1),
  [data-player-captions] .embed-icon:nth-child(1),
  [data-player-fullscreen] .embed-icon:nth-child(1){
    display: flex;
  }
  [data-player-play].is-playing .embed-icon:nth-child(1),
  [data-player-volume-toggle].is-muted .embed-icon:nth-child(1),
  [data-player-captions].active .embed-icon:nth-child(1),
  [data-player-fullscreen].is-fullscreen .embed-icon:nth-child(1){
    display: none;
  }
  [data-player-play] .embed-icon:nth-child(2),
  [data-player-volume-toggle] .embed-icon:nth-child(2),
  [data-player-captions] .embed-icon:nth-child(2),
  [data-player-fullscreen] .embed-icon:nth-child(2) {
    display: none;
  }
  [data-player-play].is-playing .embed-icon:nth-child(2),
  [data-player-volume-toggle].is-muted .embed-icon:nth-child(2),
  [data-player-captions].active .embed-icon:nth-child(2),
  [data-player-fullscreen].is-fullscreen .embed-icon:nth-child(2){
    display: flex;
  }

  @media screen and (max-width: 767px) {
    .btn {
      width: 3rem;
      height: 3rem;
    }
    .dropdown-wrap { 
      width: 3rem;
      height: 3rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .neaxt-back-wr{
      display: none;
    }
    [data-player-speed-menu]{
      bottom: 56px;
      flex-direction: row;
      left: auto;
      right: auto;
      border-left: 1px solid #FFFFFF29;
      border-bottom: 1px solid #FFFFFF29;
      border-top: 1px solid #FFFFFF29;
      border-right: none;
    }
    .hide-mobile{
      display: none;
    }
    [data-player-speed]{
      font-size: 12px;
      line-height: 20px;
      border-right: 1px solid #FFFFFF29;
      padding: 8px 12px 6px 12px;
    }
    [data-player-volume-dropdown] {
      width: 120px;
      padding: 10px;
      flex-direction: row;
      align-items: center;
      gap: 0px;
      bottom: 56px;
    }

    .volume-slider-wrap {
      width: 100px;
      height: 20px;
      align-items: center;
    }

    [data-player-volume-track] {
      width: 100%;
      height: 2px;
      cursor: pointer;
      transition: height 0.12s;
    }

    [data-player-volume-fill] {
      top: 0; left: 0;
      height: 100%;
      width: 100%;
    }

    [data-player-volume-thumb] {
      top: 50%;
      left: 100%;
      bottom: auto;
      transform: translate(-50%, -50%);
    }

    [data-player-root]:has([data-player-9-16]) [data-player-speed-menu]{
      flex-direction: column;
      bottom: auto;
      right: 0;
      top: 48px;
      min-width: 60px;
    }
  }
</style></div></div><div class="page-styles"><div class="cc-levels w-embed"><style>
