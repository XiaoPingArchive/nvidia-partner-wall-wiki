</style></div></div><div data-banner-mobile="" data-banner="show" class="nav__banner"><div class="top-banner_code w-embed w-script"><script>
document.addEventListener('DOMContentLoaded', function () {
  const banner = document.querySelector('.nav__banner');
  const closeButton = document.getElementById('banner-close');

  const bannerState = banner?.getAttribute('data-banner');
  if (bannerState === 'hide') {
    banner?.classList.remove('show');
    return; 
  }

  const lastShown = localStorage.getItem('bannerLastShown');
  const now = new Date();

  let shouldShow = true;

  if (lastShown) {
    const lastShownDate = new Date(lastShown);
    const diffDays = Math.floor((now - lastShownDate) / (1000 * 60 * 60 * 24));
    if (diffDays <= 7) {
      shouldShow = false;
    }
  }

  const bannerClosed = localStorage.getItem('bannerClosed');
  if (bannerClosed === 'true') {
    shouldShow = false;
  }
	
  console.log("🤖 Final decision: shouldShow =", shouldShow);
  if (shouldShow) {
    banner?.classList.add('show');
  }

  closeButton?.addEventListener('click', function () {
    banner?.classList.remove('show');
    localStorage.setItem('bannerClosed', 'true');
    localStorage.setItem('bannerLastShown', now.toISOString());
  });
});
</script></div><a id="banner-close" aria-label="close banner" data-wf-native-id-path="5a8a46a7-3152-c479-30c8-767440a02702:6960bb15-102f-719d-1fd3-19bdf1c27bb6" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="6960bb15-102f-719d-1fd3-19bdf1c27bb6" data-wf-component-context="%5B%7B%22componentId%22%3A%226960bb15-102f-719d-1fd3-19bdf1c27bb4%22%2C%22instanceId%22%3A%225a8a46a7-3152-c479-30c8-767440a02702%22%7D%5D" href="#" class="nav-banner__close-button w-inline-block"><div class="nav-banner__close-button__image w-embed"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
