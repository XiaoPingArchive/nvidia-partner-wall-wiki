    window._I18N_LANG_MAP_ = {"404-not-found":"系统维护中，请稍后重试","SEO.description":"字节跳动成立于2012年3月，目前公司的产品和服务已覆盖全球150个国家和地区、75个语种，曾在40多个国家和地区位居应用商店总榜前列。","SEO.keywords":"字节跳动, 字节, 字节跳动官网, ByteDance, 抖音, 今日头条, TikTok","SEO.title":"字节跳动","back":"返回","contact":"联系我们","contact.for-advertising":"广告合作","contact.for-business":"商务合作","contact.for-clean":"廉洁举报","contact.for-media":"媒体问询","contact.for-recruitment":"招聘相关","copyright":"© 2012-2024 字节跳动","culture.0":"始终创业","culture.0.desc":"保持创业心态，始终开创而不守成，创新而非依赖资源\n敏捷有效，最简化流程，避免简单事情复杂化\n对外敏锐谦逊，避免自满或优越感","culture.1":"多元兼容","culture.1.desc":"欣赏个体多样性，聚焦人的核心特质\n全球视角，理解不同文化、观点和实践\n善意假设，默认开放信任，有效合作","culture.2":"坦诚清晰","culture.2.desc":"表达真实想法，不怕暴露问题，反对\"向上管理\"\n准确、简洁、直接，少用抽象、模糊、空泛的词\n就事论事，理性沟通，避免主观臆测和情绪化表达","culture.3":"求真务实","culture.3.desc":"独立思考，刨根问底，找到本质\n直接体验，深入事实，拿一手数据或信息\n不自嗨，注重实际效果","culture.4":"敢为极致","culture.4.desc":"敢于为了更好的结果明智地冒险，注重整体ROI\n尝试多种可能性，在更大范围里找最优解\n追求卓越，高标准，不仅做了，更要做好","culture.5":"共同成长","culture.5.desc":"相信并认可使命和愿景，基于使命愿景自驱\n面对短期波动有耐心、有韧性，共同解决问题\n持续学习，不设边界，与组织一起成长","culture.desc":"字节范是字节跳动企业文化的重要组成部分，是我们共同认可的行为准则。","date.months.1":"1月","date.months.10":"10月","date.months.11":"11月","date.months.12":"12月","date.months.2":"2月","date.months.3":"3月","date.months.4":"4月","date.months.5":"5月","date.months.6":"6月","date.months.7":"7月","date.months.8":"8月","date.months.9":"9月","date.template":"{year}年{month}","date.template2":"{year}年{month}{date}日","for-more-info":"更多信息，请访问： {link}","investors.rank":"按首字母排序","langcode":"zh","leadership.0":"张一鸣","leadership.1":"Arthur Dantchik","leadership.2":"William Ford ","leadership.3":"Philippe Laffont","media.back":"返回","media.contact.desc":"所有从本网站下载的内容（包括照片、音频及视频等）仅用于新闻编辑之目的。严禁将本网站内容用于其他用途（包括但不限于个人或商业目的）。","media.download":"下载","media.events":"大事记","media.logos":"Logo素材","milestone.0":"字节跳动公司注册成立","milestone.1":"今日头条1.0版本上线","milestone.2":"抖音短视频上线","milestone.3":"控股印尼新闻推荐阅读平台BABE","milestone.4":"TikTok上线","milestone.5":"收购音乐视频分享和互动社交应用Musical.ly","milestone.6":"Helo上线","mission":"使命","mission.desc":"激发创造 丰富生活","nav.cod":"行为准则","nav.contact":"联系我们","nav.corporate-structure":"组织架构","nav.culture":"企业文化","nav.help-center":"帮助中心","nav.history":"大事记","nav.job":"招聘官网","nav.join-us":"加入我们","nav.media":"媒体问询","nav.products":"我们的产品","nav.resources":"媒体素材","nav.what-we-do":"我们的产品","nav.who-we-are":"关于我们","news.all":"所有新闻","news.back":"返回","news.readmore":"查看更多","news.recent":"近期新闻","news.share":"分享","news.topics":"话题","news.topics.social-responsibility":"企业社会责任","products.desc":"我们的产品与服务","products.other":"更多产品","readmore":"了解更多","resources.library":"媒体资料库","resources.newsroom":"新闻动态","tech-for-good.desc2":"更多信息，请访问：{link}"};
